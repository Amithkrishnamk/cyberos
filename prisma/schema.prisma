generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("STUDENT")
  theme        String   @default("cyan")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  notes          Note[]
  studySessions  StudySession[]
  labCompletions LabCompletion[]
}

model Note {
  id                 String   @id @default(uuid())
  title              String
  category           String   @default("Web Security")
  tags               String   @default("[]")
  content            String
  masteryPercent     Int      @default(0)
  timeStudiedMinutes Int      @default(0)
  icon               String   @default("📝")
  coverImage         String   @default("linear-gradient(to right, #0f172a, #1e293b, #0f172a)")
  description        String   @default("")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudySession {
  id              String    @id @default(uuid())
  startedAt       DateTime  @default(now())
  lastHeartbeatAt DateTime  @default(now())
  endedAt         DateTime?
  durationMinutes Int       @default(0)
  category        String?
  linkedNoteId    String?
  contentStudied  String    @default("")
  difficulties    String    @default("")
  nextSteps       String    @default("")

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LabCompletion {
  id           String   @id @default(uuid())
  labName      String
  category     String
  timeTakenMin Int      @default(0)
  keyLearnings String   @default("")
  completedAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Concept {
  id          String   @id @default(uuid())
  term        String   @unique
  definition  String
  category    String
  mastery     Int      @default(0)
  lastRevise  DateTime @default(now())
}

model ClassContent {
  id          String   @id @default("today-class")
  title       String   @default("Web Security: Advanced SQL Injection & Union Exploitation")
  category    String   @default("Web Security")
  description String   @default("Today's focus: Identifying column counts using UNION NULL injection, extracting database metadata, and practicing PortSwigger SQLi labs.")
  labUrl      String   @default("https://portswigger.net/web-security/sql-injection")
  keyNotice   String   @default("Please log your study session timer and submit your mandatory end-of-session reflection log after completing today's lab.")
  updatedAt   DateTime @default(now()) @updatedAt
}
